<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="author" content="Grupo 06" />
    <title>LEAGUES MARKET - {{title}}</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/searchbar.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    {{> header}}

    <main class="flex-grow-1 py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm">
                        <div class="card-header text-white {{#ok}}bg-success{{/ok}}{{^ok}}bg-danger{{/ok}}">
                            <h4 class="mb-0">
                                <i class="bi {{#ok}}bi-check-circle{{/ok}}{{^ok}}bi-exclamation-triangle{{/ok}} me-2"></i>{{title}}
                            </h4>
                        </div>
                        <div class="card-body">
                            <p>{{message}}</p>
                            {{#hasErrors}}
                            <ul class="text-danger">
                                {{#errors}}
                                <li>{{.}}</li>
                                {{/errors}}
                            </ul>
                            {{/hasErrors}}
                            <div class="d-flex gap-2">
                                <a href="{{backUrl}}" class="btn btn-outline-dark">
                                    <i class="bi bi-arrow-left me-1"></i> Volver al jugador
                                </a>
                                {{#retryUrl}}
                                <a href="{{retryUrl}}" class="btn btn-primary">
                                    <i class="bi bi-pencil me-1"></i> Volver a intentarlo
                                </a>
                                {{/retryUrl}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {{> footer}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
