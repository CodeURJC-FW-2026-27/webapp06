<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Formulario para crear un nuevo jugador" />
    <meta name="author" content="Grupo 06" />
    <title>LEAGUES MARKET - {{formTitle}}</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/searchbar.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    {{> header}}

    <main class="flex-grow-1 py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h4 class="mb-0">{{formTitle}}</h4>
                        </div>
                        <div class="card-body">
                            <form class="form" action="{{action}}" method="POST"
                                enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label for="player_name" class="form-label">Nombre del jugador:</label>
                                    <input type="text" class="form-control" id="player_name" name="player_name"
                                        placeholder="Nombre del jugador" value="{{player.player_name}}" />
                                </div>

                                <div class="mb-3">
                                    <label for="date_of_birth" class="form-label">Fecha de nacimiento:</label>
                                    <input type="date" class="form-control" id="date_of_birth" name="date_of_birth"
                                        value="{{player.date_of_birth}}" />
                                </div>

                                <div class="mb-3">
                                    <label for="team" class="form-label">Equipo del jugador:</label>
                                    <input type="text" class="form-control" id="team" name="team"
                                        placeholder="Equipo del jugador" value="{{player.team}}" />
                                </div>

                                <div class="mb-3">
                                    <label for="position" class="form-label">Categoría (posición del jugador):</label>
                                    <select class="form-select" id="position" name="position">
                                        <option value="" {{^hasPosition}}selected{{/hasPosition}}>Selecciona una categoría</option>
                                        {{#positionOptions}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/positionOptions}}
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="league" class="form-label">Liga:</label>
                                    <input type="text" class="form-control" id="league" name="league"
                                        placeholder="Liga" value="{{player.league}}" />
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">Descripción del jugador:</label>
                                    <textarea class="form-control" id="description" name="description" rows="3"
                                        placeholder="Escribe una descripción del jugador">{{player.description}}</textarea>
                                </div>

                                <div class="mb-3">
                                    <label for="image" class="form-label">Imagen del jugador:</label>
                                    {{#hasImage}}
                                    <div class="mb-2">
                                        <img src="{{player.image}}" alt="{{player.player_name}}"
                                            class="img-thumbnail" style="max-height: 180px" />
                                        <p class="form-text mb-0">Si no seleccionas otra imagen, se conservará la actual.</p>
                                    </div>
                                    {{/hasImage}}
                                    <input type="file" class="form-control" id="image" name="image"
                                        accept="image/*" />
                                </div>

                                <div class="mb-3">
                                    <label for="photographer" class="form-label">Fotógrafo:</label>
                                    <input type="text" class="form-control" id="photographer" name="photographer"
                                        placeholder="Nombre del fotógrafo" value="{{player.photographer}}" />
                                </div>

                                <div class="mb-3">
                                    <label for="price" class="form-label">Precio:</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <input type="number" class="form-control" id="price" name="price"
                                            placeholder="Precio" value="{{player.price}}" />
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <a href="/" class="btn btn-danger">
                                        <i class="bi bi-x-circle me-1"></i> Cancelar
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-save me-1"></i> {{submitLabel}}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {{> footer}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
