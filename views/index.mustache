<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>LEAGUES MARKET-Homepage</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/searchbar.css" rel="stylesheet" />
</head>

<body class="body">
    {{! Shared header (search + categories) }}
    {{> header}}

    <!-- Section-->
    <section class="py-5">
        <div class="container px-4 px-lg-5 mt-5">
            <div class="d-flex justify-content-end mb-4">
                {{! Link preserved from Assignment 1; Person 2 will implement the route }}
                <a class="btn btn-dark" href="/player/new">Crear nuevo elemento</a>
            </div>

            {{#hasPlayers}}
            <div class="row gx-4 gx-lg-5 row-cols-1 row-cols-md-2 row-cols-xl-3 justify-content-center">
                {{#players}}
                <div class="col mb-5">
                    {{! Detail link: Person 3 will implement GET /player/:id }}
                    <a class="text-decoration-none text-dark" href="/player/{{id}}">
                        <div class="card h-100">
                            <img class="card-img-top" src="{{image}}" alt="{{player_name}}"
                                style="height: 300px; object-fit: cover; object-position: top" />
                            <div class="card-body p-4">
                                <h5 class="fw-bolder text-center">{{player_name}}</h5>
                            </div>
                        </div>
                    </a>
                </div>
                {{/players}}
            </div>
            {{/hasPlayers}}

            {{^hasPlayers}}
            <p class="text-center text-secondary">No se encontraron jugadores.</p>
            {{/hasPlayers}}

            {{! Pagination }}
            {{#showPagination}}
            <nav aria-label="Paginación de jugadores">
                <ul class="pagination justify-content-center">
                    {{! Previous }}
                    <li class="page-item {{^hasPrev}}disabled{{/hasPrev}}">
                        <a class="page-link" {{#hasPrev}}href="{{{prevUrl}}}"{{/hasPrev}}
                           aria-label="Anterior">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    {{! Numbered pages }}
                    {{#pages}}
                    <li class="page-item {{#active}}active{{/active}}">
                        <a class="page-link" href="{{{url}}}">{{number}}</a>
                    </li>
                    {{/pages}}
                    {{! Next }}
                    <li class="page-item {{^hasNext}}disabled{{/hasNext}}">
                        <a class="page-link" {{#hasNext}}href="{{{nextUrl}}}"{{/hasNext}}
                           aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
            {{/showPagination}}
        </div>
    </section>

    {{! Shared footer }}
    {{> footer}}

    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="/js/scripts.js"></script>
</body>

</html>
